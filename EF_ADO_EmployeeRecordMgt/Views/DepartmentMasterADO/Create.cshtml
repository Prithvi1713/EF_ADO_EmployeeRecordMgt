@model EF_ADO_EmployeeRecordMgt.Models.DepartmentMaster

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>ADO_DepartmentMaster</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="DeptName"></label>
                <input asp-for="DeptName" class="form-control" />
                <span asp-validation-for="DeptName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>From Date</label>
                <input type="date" id="" class="form-control export-from-date" />

                <label>To Date</label>
                <input type="date" id="" class="form-control export-to-date" />
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a class="btn btn-secondary" asp-action="Index">Back to List</a>
            </div>
            
        </form>


    </div>
</div>

<!-- ✅ SCRIPTS (ONLY ONCE, AT BOTTOM) -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/scripts/customvalidations.js"></script>

<script>
    $(function () {
        applyExportDateValidation("#From", "#To");
    });
</script>
